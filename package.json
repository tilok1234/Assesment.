{
  "name": "8-bit-sprite-assembler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Procedural 24x24 character and enemy sprite assembler",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "dev:open": "node tools/dev-server.mjs --open",
    "build": "node tools/build.mjs",
    "preview": "node tools/dev-server.mjs --root dist --open",
    "review:enemy-outlines": "node tools/enemy-outline-assessment.mjs",
    "review:enemy-outline-pilots": "node tools/enemy-outline-pilot-review.mjs",
    "review:transparency": "node tools/transparent-tile-review.mjs",
    "review:weapons": "node tools/weapon-readability-audit.mjs",
    "review:outlines": "node tools/outline-review.mjs",
    "review:shades": "node tools/shade-review.mjs",
    "review:offhands": "node tools/offhand-review.mjs",
    "review:production-rolls": "node tools/production-roll-review.mjs",
    "review:cast": "node tools/cast-review.mjs",
    "review:death": "node tools/death-review.mjs",
    "export:bosses:13": "node tools/export-established-boss-pack.mjs",
    "check:pack-publish": "node tools/check-pack-publisher.mjs",
    "check": "node tools/check-project.mjs",
    "check:fast": "node tools/check-project.mjs --fast",
    "check:bosses": "node tools/check-boss-directions.mjs && node tools/check-boss-animations.mjs",
    "check:bosses:strict": "node tools/check-boss-directions.mjs --strict-checkpoints && node tools/check-boss-animations.mjs --strict-checkpoints",
    "export:fixtures": "node tools/export-enemy-fixtures.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles nsis",
    "tauri:build:exe": "tauri build --no-bundle",
    "check:release": "node tools/check-windows-release.mjs",
    "release:windows": "npm run check && npm run tauri:build && npm run check:release -- --require-artifact"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1"
  }
}
