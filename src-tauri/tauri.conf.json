{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "8-Bit Sprite Assembler",
  "version": "0.1.0",
  "identifier": "com.tilok1234.spriteassembler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "8-Bit Sprite Assembler",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "publisher": "tilok1234",
    "shortDescription": "Create and export procedural 8-bit sprite sheets",
    "longDescription": "Build player characters, enemies, effects, equipment variants, class packs, and complete reusable sprite kits.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
